// coffie billing system
#include <iostream>
using namespace std;

int main()
{
    int coffeePrice = 30;
    int quantity = 5;
    int total;

    total = coffeePrice * quantity;

    cout << "Price of 1 coffee = " << coffeePrice << " rupees" << endl;
