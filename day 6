    return 0;
}



// program 2 
// store discount appplication 
// find 10%-- amount * 0.10
// discount amount -- amount - 10% amount

#include <iostream>
using namespace std;

float discount(float discount){
    return discount -(discount *0.10);
    
}
int main(){
    cout<< discount(5000);
}


