// 1 to 10 using for loop

#include <iostream>
using namespace std;

int main(){
    for(int i = 1; i<= 10; i++){
        cout << i << "";
    }
}

// print even  number 
int main() {
    int n;

    cout << "Enter a number: ";
    cin >> n;

    cout << "Even numbers from 1 to " << n << " are:\n";

    for(int i = 1; i <= n; i++) {
        if(i % 2 == 0) {
            cout << i << " ";
        }
    }

    return 0;
}


// print 1 to 10 number using while
#include <iostream>
using namespace std;

int main (){
    int i = 1;
    while(int i <= 10){
        cout << i << "";
        i++;
        
    }
}
// print 1 to 10 using do-while loop


#include<iostream>
using namespace std;

int main(){
    int i = 1;
    do {
        cout<< i << "";
        i++;
        
    } while( i <= 10);
}

