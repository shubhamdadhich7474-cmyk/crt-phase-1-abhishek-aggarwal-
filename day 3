// problem no 7 
// prime number using boolean
#include <iostream>
using namespace std;

int main(){
    int n;
    cin >> n;
    bool is prime = true;
    
    if(n < 2){
        isprime = false;
        
    }else{
        for(int i = 2; i < n; i++){
            if(n % i==0){
                isprime = false;
                break;
            }
        }
    }
    if(isprime){
        cout << "it is a prime number...";
        
    }else{
        cout << "it is not a prime number...";
    }
}
